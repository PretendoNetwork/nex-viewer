{
  "name": "nex-viewer",
  "version": "1.0.0",
  "description": "Utility for parsing and viewing NEX connections from packet captures",
  "main": "dist/windows/main",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "clean": "rimraf ./dist",
    "copy-static": "npm run copy-html && npm run copy-css",
    "copy-html": "copyfiles ./src/renderers/main/index.html ./dist/renderers/main/index.html",
    "copy-css": "copyfiles ./src/renderers/main/assets/css/* ./dist/renderers/main/assets/css/",
    "build": "npm run lint && npm run clean && npm run compile && npm run browserify",
    "compile": "npx tsc && npx tsc-alias && npm run copy-static",
    "browserify": "glob-exec ./dist/renderers/main/assets/js/*.js -- \"browserify {{files.join(' ')}} -o ./dist/renderers/main/assets/js/bundle.js\"",
    "start": "electron ."
  },
  "keywords": [],
  "author": "Pretendo Network",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@pretendonetwork/eslint-config": "^0.0.8",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^18.3.3",
    "@types/semver": "^7.5.8",
    "@types/source-map-support": "^0.5.10",
    "browserify": "^17.0.0",
    "copyfiles": "^2.4.1",
    "electron": "^30.0.1",
    "eslint": "^9.21.0",
    "glob-exec": "^0.1.1",
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@pretendonetwork/java.io": "^1.0.0",
    "@pretendonetwork/yeah": "^1.0.0",
    "compare-versions": "^6.1.1",
    "fs-extra": "^11.2.0",
    "semver": "^7.6.0",
    "source-map-support": "^0.5.21"
  }
}